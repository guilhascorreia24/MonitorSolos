# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=smart_vineyard

# InfluxDB
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=
INFLUXDB_ORG=vineyard
INFLUXDB_BUCKET=vineyard_data
INFLUXDB_ADMIN_TOKEN=

# Grafana
GRAFANA_PASSWORD=admin

# Infrastructure (Local)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MQTT_SERVER_URI=tcp://localhost:1883

# Infrastructure (Docker)
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:29092
MQTT_SERVER_URI_DOCKER=tcp://mosquitto:1883

# Deployment
DOCKER_IMAGE_BASE=ghcr.io/your-username/monitorsolos

# Frontend API URLs (Server-side)
INTERNAL_API_URL=http://api-gateway:8000/api
